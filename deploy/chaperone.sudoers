# Example: install with visudo -cf. Every user may call _enter: it asks the
# directory itself whether the caller is eligible (fresh, not SSSD's cache),
# so a user added to the eligible group launches at once.
# use_pty: the persona gets its own terminal and cannot push keystrokes into
# the caller's shell (TIOCSTI).
# No env_keep: the persona's environment comes from its profile (shell,
# env), not from the caller's.
Defaults!/usr/local/bin/chaperone use_pty
ALL ALL=(root) NOPASSWD: /usr/local/bin/chaperone _enter *
