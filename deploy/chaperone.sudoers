# Rendered by deploy/install.yml from the root-owned persona profiles.
# Only explicitly forwarded environment variables reach the persona.
# Sudo also strips unsafe dynamic-loader variables by its own policy.
Defaults!/usr/local/bin/chaperone use_pty
Defaults!/usr/local/bin/chaperone env_keep += "{{ chaperone_policy.personas.values() | map(attribute='forward_env', default=[]) | flatten | unique | sort | join(' ') }}"
ALL ALL=(root) NOPASSWD: /usr/local/bin/chaperone _enter *
