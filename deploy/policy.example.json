{
  "default_persona": "ai",
  "eligible_groups": ["chaperone-users"],
  "personas": {
    "ai": {
      "slurm_account": "agents",
      "list_home": true,
      "workdir": "auto",
      "login": true,
      "write": [".claude", ".codex", ".config/opencode"],
      "read": [".local/bin", ".local/share/claude", ".bash_profile", ".bashrc", ".profile", ".gitconfig"]
    },
    "ai-restrictive": {
      "slurm_account": "agents",
      "workdir": "off",
      "write": [".claude", ".codex", ".config/opencode"],
      "read": [".local/bin", ".local/share/claude"]
    }
  }
}
