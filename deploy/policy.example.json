{
  "default_persona": "ai",
  "eligible_groups": ["chaperone-users"],
  "personas": {
    "ai": {
      "slurm_account": "agents",
      "shell": "/bin/bash",
      "ban_groups": ["admins"]
    },
    "ai-restrictive": {
      "slurm_account": "agents",
      "shell": "/bin/bash",
      "env": {"CLAUDE_CONFIG_DIR": "$HOME/.claude"},
      "groups": [],
      "home_readonly": true,
      "writable": [".claude", ".codex", ".config/opencode", ".cache", ".local/share", ".local/state"],
      "hidden": [".ssh", ".gnupg"]
    }
  }
}
