[Unit]
Description=Chaperone persona provisioner
After=network-online.target munge.service sssd.service
Wants=network-online.target

[Service]
Type=simple
# Dedicated service user (provisiond refuses root): scoped IPA role via the
# client keytab below, Slurm AdminLevel=Operator for sacctmgr.
User=chaperone
Group=chaperone
StateDirectory=chaperone
Environment=HOME=/var/lib/chaperone
Environment=KRB5_CLIENT_KTNAME=/etc/chaperone/chaperone.keytab
Environment=KRB5CCNAME=FILE:/var/lib/chaperone/krb5cc
# Same-host login node: loopback only. Clients must not use https_proxy.
ExecStart=/usr/local/bin/chaperone provisiond --listen 127.0.0.1:9443 --cert /etc/chaperone/tls.crt --key /etc/chaperone/tls.key
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
